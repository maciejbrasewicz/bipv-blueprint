{
  "$defs": {
    "Obstacle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "chimney",
          "enum": [
            "chimney",
            "skylight"
          ],
          "title": "Kind",
          "type": "string"
        },
        "surface_id": {
          "default": "south",
          "enum": [
            "south",
            "north"
          ],
          "title": "Surface Id",
          "type": "string"
        },
        "u": {
          "maximum": 40,
          "minimum": 0,
          "title": "U",
          "type": "number"
        },
        "v": {
          "maximum": 40,
          "minimum": 0,
          "title": "V",
          "type": "number"
        },
        "width_m": {
          "default": 0.8,
          "maximum": 4,
          "minimum": 0.2,
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.2,
          "title": "Depth M",
          "type": "number"
        },
        "height_m": {
          "default": 1.1,
          "maximum": 4,
          "minimum": 0.05,
          "title": "Height M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "u",
        "v"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "Roof": {
      "additionalProperties": false,
      "properties": {
        "width_m": {
          "default": 14,
          "maximum": 30,
          "minimum": 4,
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "default": 10,
          "maximum": 24,
          "minimum": 4,
          "title": "Depth M",
          "type": "number"
        },
        "pitch_deg": {
          "default": 32,
          "maximum": 60,
          "minimum": 5,
          "title": "Pitch Deg",
          "type": "number"
        },
        "eaves_m": {
          "default": 3.2,
          "maximum": 12,
          "minimum": 2,
          "title": "Eaves M",
          "type": "number"
        },
        "azimuth_deg": {
          "default": 180,
          "maximum": 359,
          "minimum": 0,
          "title": "Azimuth Deg",
          "type": "number"
        }
      },
      "title": "Roof",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "name": {
      "default": "Dom pod Szczecinem",
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "roof": {
      "$ref": "#/$defs/Roof"
    },
    "obstacles": {
      "items": {
        "$ref": "#/$defs/Obstacle"
      },
      "maxItems": 12,
      "title": "Obstacles",
      "type": "array"
    },
    "product_id": {
      "default": "slate-75",
      "enum": [
        "slate-75",
        "tile-32",
        "panel-120"
      ],
      "title": "Product Id",
      "type": "string"
    },
    "setback_m": {
      "default": 0.25,
      "maximum": 1,
      "minimum": 0.05,
      "title": "Setback M",
      "type": "number"
    },
    "gap_m": {
      "default": 0.015,
      "maximum": 0.1,
      "minimum": 0.005,
      "title": "Gap M",
      "type": "number"
    },
    "clearance_m": {
      "default": 0.2,
      "maximum": 1,
      "minimum": 0,
      "title": "Clearance M",
      "type": "number"
    },
    "surfaces": {
      "items": {
        "enum": [
          "south",
          "north"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Surfaces",
      "type": "array"
    }
  },
  "title": "Scene",
  "type": "object"
}
