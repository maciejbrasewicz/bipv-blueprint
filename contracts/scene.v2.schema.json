{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "GridPoint": {
      "additionalProperties": false,
      "properties": {
        "easting_m": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Easting M",
          "type": "number"
        },
        "northing_m": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Northing M",
          "type": "number"
        }
      },
      "required": [
        "easting_m",
        "northing_m"
      ],
      "title": "GridPoint",
      "type": "object"
    },
    "Obstacle": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "chimney",
          "enum": [
            "chimney",
            "skylight"
          ],
          "title": "Kind",
          "type": "string"
        },
        "surface_id": {
          "default": "south",
          "pattern": "^[a-zA-Z0-9_-]{1,48}$",
          "title": "Surface Id",
          "type": "string"
        },
        "u": {
          "maximum": 40,
          "minimum": -40,
          "title": "U",
          "type": "number"
        },
        "v": {
          "maximum": 40,
          "minimum": -40,
          "title": "V",
          "type": "number"
        },
        "width_m": {
          "default": 0.8,
          "maximum": 4,
          "minimum": 0.2,
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.2,
          "title": "Depth M",
          "type": "number"
        },
        "height_m": {
          "default": 1.1,
          "maximum": 4,
          "minimum": 0.05,
          "title": "Height M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "u",
        "v"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "OrthophotoTrace": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "gugik-orto-wms",
          "title": "Source",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/GridPoint"
        },
        "outline_en_m": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 60,
                "minimum": -60,
                "type": "number"
              },
              {
                "maximum": 60,
                "minimum": -60,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 48,
          "minItems": 3,
          "title": "Outline En M",
          "type": "array"
        },
        "roof_height_m": {
          "exclusiveMinimum": 0,
          "maximum": 40,
          "title": "Roof Height M",
          "type": "number"
        },
        "building_id": {
          "pattern": "^[\\w./-]{1,96}$",
          "title": "Building Id",
          "type": "string"
        },
        "suggestion_method": {
          "anyOf": [
            {
              "const": "seed-rgb-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion Method"
        },
        "gable": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceGable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source",
        "image_sha256",
        "retrieved_at",
        "center",
        "outline_en_m",
        "roof_height_m",
        "building_id"
      ],
      "title": "OrthophotoTrace",
      "type": "object"
    },
    "PlanarSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,48}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "roof",
            "facade"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 40,
              "minimum": -40,
              "type": "number"
            },
            {
              "maximum": 40,
              "minimum": -40,
              "type": "number"
            },
            {
              "maximum": 40,
              "minimum": -40,
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "u": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            }
          ],
          "title": "U",
          "type": "array"
        },
        "v": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            }
          ],
          "title": "V",
          "type": "array"
        },
        "boundary_uv_m": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 40,
                "minimum": -40,
                "type": "number"
              },
              {
                "maximum": 40,
                "minimum": -40,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 48,
          "minItems": 3,
          "title": "Boundary Uv M",
          "type": "array"
        },
        "holes_uv_m": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 40,
                  "minimum": -40,
                  "type": "number"
                },
                {
                  "maximum": 40,
                  "minimum": -40,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "maxItems": 48,
            "minItems": 3,
            "type": "array"
          },
          "maxItems": 4,
          "title": "Holes Uv M",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "origin",
        "u",
        "v",
        "boundary_uv_m"
      ],
      "title": "PlanarSurface",
      "type": "object"
    },
    "Roof": {
      "additionalProperties": false,
      "properties": {
        "width_m": {
          "default": 14,
          "maximum": 30,
          "minimum": 4,
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "default": 10,
          "maximum": 24,
          "minimum": 4,
          "title": "Depth M",
          "type": "number"
        },
        "pitch_deg": {
          "default": 32,
          "maximum": 60,
          "minimum": 5,
          "title": "Pitch Deg",
          "type": "number"
        },
        "eaves_m": {
          "default": 3.2,
          "maximum": 12,
          "minimum": 2,
          "title": "Eaves M",
          "type": "number"
        },
        "azimuth_deg": {
          "default": 180,
          "maximum": 359,
          "minimum": 0,
          "title": "Azimuth Deg",
          "type": "number"
        }
      },
      "title": "Roof",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "default": "Dom pod Szczecinem",
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "roof": {
          "$ref": "#/$defs/Roof"
        },
        "obstacles": {
          "items": {
            "$ref": "#/$defs/Obstacle"
          },
          "maxItems": 12,
          "title": "Obstacles",
          "type": "array"
        },
        "product_id": {
          "default": "slate-75",
          "enum": [
            "slate-75",
            "tile-32",
            "panel-120"
          ],
          "title": "Product Id",
          "type": "string"
        },
        "setback_m": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0.05,
          "title": "Setback M",
          "type": "number"
        },
        "gap_m": {
          "default": 0.015,
          "maximum": 0.1,
          "minimum": 0.005,
          "title": "Gap M",
          "type": "number"
        },
        "clearance_m": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Clearance M",
          "type": "number"
        },
        "surfaces": {
          "items": {
            "pattern": "^[a-zA-Z0-9_-]{1,48}$",
            "type": "string"
          },
          "maxItems": 6,
          "title": "Surfaces",
          "type": "array"
        },
        "custom_surfaces": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/PlanarSurface"
              },
              "maxItems": 6,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Surfaces"
        }
      },
      "title": "Scene",
      "type": "object"
    },
    "SceneOrigin": {
      "additionalProperties": false,
      "properties": {
        "latitude_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude Deg",
          "type": "number"
        },
        "longitude_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude Deg",
          "type": "number"
        },
        "ellipsoidal_height_m": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": -500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ellipsoidal Height M"
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg"
      ],
      "title": "SceneOrigin",
      "type": "object"
    },
    "SceneSite": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "building_id": {
          "pattern": "^[\\w./-]{1,96}$",
          "title": "Building Id",
          "type": "string"
        },
        "latitude_deg": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude Deg",
          "type": "number"
        },
        "longitude_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude Deg",
          "type": "number"
        },
        "source": {
          "const": "gugik-egib-wfs",
          "title": "Source",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "address",
        "building_id",
        "latitude_deg",
        "longitude_deg",
        "source",
        "retrieved_at"
      ],
      "title": "SceneSite",
      "type": "object"
    },
    "SurfaceEvidence": {
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,48}$",
          "title": "Surface Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "estimated",
            "measured",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Source Asset Ids",
          "type": "array"
        },
        "orthophoto_trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrthophotoTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "egib_assumed_height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 40,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egib Assumed Height M"
        }
      },
      "required": [
        "surface_id",
        "status"
      ],
      "title": "SurfaceEvidence",
      "type": "object"
    },
    "TraceGable": {
      "additionalProperties": false,
      "properties": {
        "ridge_en_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 60,
                  "minimum": -60,
                  "type": "number"
                },
                {
                  "maximum": 60,
                  "minimum": -60,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 60,
                  "minimum": -60,
                  "type": "number"
                },
                {
                  "maximum": 60,
                  "minimum": -60,
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Ridge En M",
          "type": "array"
        },
        "pitch_deg": {
          "maximum": 60,
          "minimum": 5,
          "title": "Pitch Deg",
          "type": "number"
        }
      },
      "required": [
        "ridge_en_m",
        "pitch_deg"
      ],
      "title": "TraceGable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/Scene"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "site": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneSite"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "surface_evidence": {
      "items": {
        "$ref": "#/$defs/SurfaceEvidence"
      },
      "maxItems": 6,
      "title": "Surface Evidence",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "geometry"
  ],
  "title": "SceneV2",
  "type": "object"
}
